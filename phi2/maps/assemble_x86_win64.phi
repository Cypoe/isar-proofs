;; assemble_x86_win64 — GENERATED by host/gen_x86_map.py
;; Do not hand-edit: synthesized from the mined ISA rows
;; (host/isa_x86_64.py ENCS/INSN/REG tables) and the declared PE64
;; layout (host/target_pe64.py symbols/text_rva).
;;
;; uses: ../std/arith_nibble_carry, ../std/arith_peano_succ, ../std/lists_append_mapfold, ../std/lists_member_assoc, ../std/unify_terms_core, ../std/meta_call_run
;;
;; Two-pass pc-threaded assembly:
;;   pass1<ops, pc8> = labs        label -> section-offset (nl8)
;;   assemble2<ops, labs, pc8>     enc2 with 'l/'p fixups:
;;     'l: disp = (trva + off) - (trva + pc + len)
;;     'p: disp = symtab -       (trva + pc + len)
;; nibble-domain subtraction: wrap IS two's-complement.

;; ---------- nibble arithmetic ----------

nibble_pred : <n: T[4]> <-> <PAIR(p, w)> where {
  | n = ATOM(4,0)  { p = ATOM(4,15)   w = ATOM(4,1) }
  | n = ATOM(4,1)  { p = ATOM(4,0)   w = ATOM(4,0) }
  | n = ATOM(4,2)  { p = ATOM(4,1)   w = ATOM(4,0) }
  | n = ATOM(4,3)  { p = ATOM(4,2)   w = ATOM(4,0) }
  | n = ATOM(4,4)  { p = ATOM(4,3)   w = ATOM(4,0) }
  | n = ATOM(4,5)  { p = ATOM(4,4)   w = ATOM(4,0) }
  | n = ATOM(4,6)  { p = ATOM(4,5)   w = ATOM(4,0) }
  | n = ATOM(4,7)  { p = ATOM(4,6)   w = ATOM(4,0) }
  | n = ATOM(4,8)  { p = ATOM(4,7)   w = ATOM(4,0) }
  | n = ATOM(4,9)  { p = ATOM(4,8)   w = ATOM(4,0) }
  | n = ATOM(4,10)  { p = ATOM(4,9)   w = ATOM(4,0) }
  | n = ATOM(4,11)  { p = ATOM(4,10)   w = ATOM(4,0) }
  | n = ATOM(4,12)  { p = ATOM(4,11)   w = ATOM(4,0) }
  | n = ATOM(4,13)  { p = ATOM(4,12)   w = ATOM(4,0) }
  | n = ATOM(4,14)  { p = ATOM(4,13)   w = ATOM(4,0) }
  | n = ATOM(4,15)  { p = ATOM(4,14)   w = ATOM(4,0) }
}

nibble_sub_b : <a: T[4], b: T[4]> <-> <PAIR(d, w)> shape self where {
  | b = ATOM(4,0) { d = a   w = ATOM(4,0) }
  | fresh(bp, s1, w1, s2, w2, wo) {
      b != ATOM(4,0)
      nibble_pred<b> = PAIR(bp, _)
      nibble_pred<a> = PAIR(s1, w1)
      nibble_sub_b<s1, bp> = PAIR(s2, w2)
      bor<w1, w2> = wo
      d = s2   w = wo
    }
}

nibble_half_sub : <a: T[4], b: T[4], cin: T[4]> <-> <PAIR(d, cout)> where {
  | fresh(s1, w1, w2) {
      nibble_sub_b<a, b> = PAIR(s1, w1)
      nibble_sub_b<s1, cin> = PAIR(d, w2)
      bor<w1, w2> = cout
    }
}

nibble_sub : <a, b, br: T[4]> <-> <result> shape self where {
  | a = [] & b = [] { result = [] }
  | fresh(an, bn, dn, cn, at, bt, rest) {
      head<a> = an   tail<a> = at
      head<b> = bn   tail<b> = bt
      nibble_half_sub<an, bn, br> = PAIR(dn, cn)
      nibble_sub<at, bt, cn> = rest
      result = PAIR(dn, rest)
    }
}

;; local ripple adder — corpus nibble_add_b clause2 has no b!=0
;; guard, so it yields a phantom wrap sol on re-pull; this variant is
;; sol-disjoint (backtracking-safe).
nadd_b : <a: T[4], b: T[4]> <-> <PAIR(d, w)> shape self where {
  | b = ATOM(4,0) { d = a   w = ATOM(4,0) }
  | fresh(bp, s1, w1, s2, w2, wo) {
      b != ATOM(4,0)
      nibble_succ<bp> = PAIR(b, _)
      nibble_succ<a> = PAIR(s1, w1)
      nadd_b<s1, bp> = PAIR(s2, w2)
      bor<w1, w2> = wo
      d = s2   w = wo
    }
}

nadd_h : <a: T[4], b: T[4], cin: T[4]> <-> <PAIR(d, cout)> where {
  | fresh(s1, w1, w2) {
      nadd_b<a, b> = PAIR(s1, w1)
      nadd_b<s1, cin> = PAIR(d, w2)
      bor<w1, w2> = cout
    }
}

nl_add : <a, b, cin: T[4]> <-> <result> shape self where {
  | a = [] & b = [] { result = [] }
  | fresh(an, bn, dn, cn, at, bt, rest) {
      head<a> = an   tail<a> = at
      head<b> = bn   tail<b> = bt
      nadd_h<an, bn, cin> = PAIR(dn, cn)
      nl_add<at, bt, cn> = rest
      result = PAIR(dn, rest)
    }
}

len_nl : <xs> <-> <nl> shape self where {
  | xs = [] { nl = [ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | fresh(h, t, n1) {
      xs = PAIR(h, t)
      len_nl<t> = n1
      nl_add<n1, [ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)], ATOM(4,0)> = nl
    }
}

shl4 : <h: T[4]> <-> <v> where {
  | h = ATOM(4,0)  { v = 0 }
  | h = ATOM(4,1)  { v = 16 }
  | h = ATOM(4,2)  { v = 32 }
  | h = ATOM(4,3)  { v = 48 }
  | h = ATOM(4,4)  { v = 64 }
  | h = ATOM(4,5)  { v = 80 }
  | h = ATOM(4,6)  { v = 96 }
  | h = ATOM(4,7)  { v = 112 }
  | h = ATOM(4,8)  { v = 128 }
  | h = ATOM(4,9)  { v = 144 }
  | h = ATOM(4,10)  { v = 160 }
  | h = ATOM(4,11)  { v = 176 }
  | h = ATOM(4,12)  { v = 192 }
  | h = ATOM(4,13)  { v = 208 }
  | h = ATOM(4,14)  { v = 224 }
  | h = ATOM(4,15)  { v = 240 }
}

bplus : <x, n> <-> <r> shape self where {
  | n = ATOM(4,0) { r = x }
  | fresh(n1, x1) {
      n != ATOM(4,0)
      nibble_pred<n> = PAIR(n1, _)
      x1 = ATOM(8, x+1)
      bplus<x1, n1> = r
    }
}

nibs2bytes : <nl> <-> <bs> shape self where {
  | nl = [] { bs = [] }
  | fresh(lo, hi, rest, sh, b, rb) {
      nl = PAIR(lo, PAIR(hi, rest))
      shl4<hi> = sh   bplus<sh, lo> = b
      nibs2bytes<rest> = rb
      bs = PAIR(b, rb)
    }
}

;; ---------- predicates as flags (no negation-as-failure) ----------

;; nlz/nlf: partial all-zero / all-F tests (guard use only)
nlz : <nl> <-> <ok> shape self where {
  | nl = [] { ok = 1 }
  | fresh(t) { nl = PAIR(ATOM(4,0), t)   nlz<t> = _   ok = 1 }
}

nlf : <nl> <-> <ok> shape self where {
  | nl = [] { ok = 1 }
  | fresh(t) { nl = PAIR(ATOM(4,15), t)   nlf<t> = _   ok = 1 }
}

;; total flag variants — single-sol, usable as 0/1 values
nlzf : <nl> <-> <f> shape self where {
  | nl = [] { f = 1 }
  | fresh(t, r) { nl = PAIR(ATOM(4,0), t)   nlzf<t> = f }
  | fresh(h, t) { nl = PAIR(h, t)   h != ATOM(4,0)   f = 0 }
}

nlff : <nl> <-> <f> shape self where {
  | nl = [] { f = 1 }
  | fresh(t, r) { nl = PAIR(ATOM(4,15), t)   nlff<t> = f }
  | fresh(h, t) { nl = PAIR(h, t)   h != ATOM(4,15)   f = 0 }
}

lon4 : <n> <-> <ok> where {
  | n = ATOM(4,0) { ok = 1 }
  | n = ATOM(4,1) { ok = 1 }
  | n = ATOM(4,2) { ok = 1 }
  | n = ATOM(4,3) { ok = 1 }
  | n = ATOM(4,4) { ok = 1 }
  | n = ATOM(4,5) { ok = 1 }
  | n = ATOM(4,6) { ok = 1 }
  | n = ATOM(4,7) { ok = 1 }
}
hin4 : <n> <-> <ok> where {
  | n = ATOM(4,8) { ok = 1 }
  | n = ATOM(4,9) { ok = 1 }
  | n = ATOM(4,10) { ok = 1 }
  | n = ATOM(4,11) { ok = 1 }
  | n = ATOM(4,12) { ok = 1 }
  | n = ATOM(4,13) { ok = 1 }
  | n = ATOM(4,14) { ok = 1 }
  | n = ATOM(4,15) { ok = 1 }
}

lon4f : <n> <-> <f> where {
  | n = ATOM(4,0) { f = 1 }
  | n = ATOM(4,1) { f = 1 }
  | n = ATOM(4,2) { f = 1 }
  | n = ATOM(4,3) { f = 1 }
  | n = ATOM(4,4) { f = 1 }
  | n = ATOM(4,5) { f = 1 }
  | n = ATOM(4,6) { f = 1 }
  | n = ATOM(4,7) { f = 1 }
  | n = ATOM(4,8) { f = 0 }
  | n = ATOM(4,9) { f = 0 }
  | n = ATOM(4,10) { f = 0 }
  | n = ATOM(4,11) { f = 0 }
  | n = ATOM(4,12) { f = 0 }
  | n = ATOM(4,13) { f = 0 }
  | n = ATOM(4,14) { f = 0 }
  | n = ATOM(4,15) { f = 0 }
}
hin4f : <n> <-> <f> where {
  | n = ATOM(4,0) { f = 0 }
  | n = ATOM(4,1) { f = 0 }
  | n = ATOM(4,2) { f = 0 }
  | n = ATOM(4,3) { f = 0 }
  | n = ATOM(4,4) { f = 0 }
  | n = ATOM(4,5) { f = 0 }
  | n = ATOM(4,6) { f = 0 }
  | n = ATOM(4,7) { f = 0 }
  | n = ATOM(4,8) { f = 1 }
  | n = ATOM(4,9) { f = 1 }
  | n = ATOM(4,10) { f = 1 }
  | n = ATOM(4,11) { f = 1 }
  | n = ATOM(4,12) { f = 1 }
  | n = ATOM(4,13) { f = 1 }
  | n = ATOM(4,14) { f = 1 }
  | n = ATOM(4,15) { f = 1 }
}

and2 : <a, b> <-> <r> where {
  | a = 0 { r = 0 }
  | a != 0 & b = 0 { r = 0 }
  | a != 0 & b != 0 { r = 1 }
}

;; se8f<nl> = 1 iff the canonical signed nl fits i8
;; (nibbles 2.. == sign extension of nibble 1) — total
se8f : <nl> <-> <f> where {
  | fresh(n0, n1, rest, z, ff, lo, hi, a, b) {
      nl = PAIR(n0, PAIR(n1, rest))
      nlzf<rest> = z   nlff<rest> = ff
      lon4f<n1> = lo   hin4f<n1> = hi
      and2<z, lo> = a   and2<ff, hi> = b
      or2<a, b> = f
    }
}

;; i32f: canonical rep is nl8 iff value fits signed 32
i32f : <nl> <-> <f> where {
  | nl = [_, _, _, _, _, _, _, _] { f = 1 }
  | nl = [_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _] { f = 0 }
}

accf : <o> <-> <f> where {
  | fresh(lo, hi) {
      regc<o> = PAIR(lo, hi)   lo = ATOM(4,0)   hi = ATOM(4,0)
      f = 1
    }
  | fresh(lo, hi) {
      regc<o> = PAIR(lo, hi)   lo != ATOM(4,0)   f = 0
    }
  | fresh(lo, hi) {
      regc<o> = PAIR(lo, hi)   hi != ATOM(4,0)   f = 0
    }
  | o = PAIR(_, _) { f = 0 }
}

or2 : <a, b> <-> <r> where {
  | a = 0 & b = 0 { r = 0 }
  | a = 0 & b != 0 { r = 1 }
  | a != 0 { r = 1 }
}

;; ---------- register tables ----------
;; regc: name -> (code&7, code>>3); all width families share
;; the code space (rax/eax/al -> 0).
regc : <r> <-> <PAIR(lo, hi)> where {
  | r = 'rax { lo = ATOM(4,0)   hi = ATOM(4,0) }
  | r = 'rcx { lo = ATOM(4,1)   hi = ATOM(4,0) }
  | r = 'rdx { lo = ATOM(4,2)   hi = ATOM(4,0) }
  | r = 'rbx { lo = ATOM(4,3)   hi = ATOM(4,0) }
  | r = 'rsp { lo = ATOM(4,4)   hi = ATOM(4,0) }
  | r = 'rbp { lo = ATOM(4,5)   hi = ATOM(4,0) }
  | r = 'rsi { lo = ATOM(4,6)   hi = ATOM(4,0) }
  | r = 'rdi { lo = ATOM(4,7)   hi = ATOM(4,0) }
  | r = 'r8 { lo = ATOM(4,0)   hi = ATOM(4,1) }
  | r = 'r9 { lo = ATOM(4,1)   hi = ATOM(4,1) }
  | r = 'r10 { lo = ATOM(4,2)   hi = ATOM(4,1) }
  | r = 'r11 { lo = ATOM(4,3)   hi = ATOM(4,1) }
  | r = 'r12 { lo = ATOM(4,4)   hi = ATOM(4,1) }
  | r = 'r13 { lo = ATOM(4,5)   hi = ATOM(4,1) }
  | r = 'r14 { lo = ATOM(4,6)   hi = ATOM(4,1) }
  | r = 'r15 { lo = ATOM(4,7)   hi = ATOM(4,1) }
  | r = 'eax { lo = ATOM(4,0)   hi = ATOM(4,0) }
  | r = 'ecx { lo = ATOM(4,1)   hi = ATOM(4,0) }
  | r = 'edx { lo = ATOM(4,2)   hi = ATOM(4,0) }
  | r = 'ebx { lo = ATOM(4,3)   hi = ATOM(4,0) }
  | r = 'esp { lo = ATOM(4,4)   hi = ATOM(4,0) }
  | r = 'ebp { lo = ATOM(4,5)   hi = ATOM(4,0) }
  | r = 'esi { lo = ATOM(4,6)   hi = ATOM(4,0) }
  | r = 'edi { lo = ATOM(4,7)   hi = ATOM(4,0) }
  | r = 'r8d { lo = ATOM(4,0)   hi = ATOM(4,1) }
  | r = 'r9d { lo = ATOM(4,1)   hi = ATOM(4,1) }
  | r = 'r10d { lo = ATOM(4,2)   hi = ATOM(4,1) }
  | r = 'r11d { lo = ATOM(4,3)   hi = ATOM(4,1) }
  | r = 'r12d { lo = ATOM(4,4)   hi = ATOM(4,1) }
  | r = 'r13d { lo = ATOM(4,5)   hi = ATOM(4,1) }
  | r = 'r14d { lo = ATOM(4,6)   hi = ATOM(4,1) }
  | r = 'r15d { lo = ATOM(4,7)   hi = ATOM(4,1) }
  | r = 'al { lo = ATOM(4,0)   hi = ATOM(4,0) }
  | r = 'cl { lo = ATOM(4,1)   hi = ATOM(4,0) }
  | r = 'dl { lo = ATOM(4,2)   hi = ATOM(4,0) }
  | r = 'bl { lo = ATOM(4,3)   hi = ATOM(4,0) }
  | r = 'spl { lo = ATOM(4,4)   hi = ATOM(4,0) }
  | r = 'bpl { lo = ATOM(4,5)   hi = ATOM(4,0) }
  | r = 'sil { lo = ATOM(4,6)   hi = ATOM(4,0) }
  | r = 'dil { lo = ATOM(4,7)   hi = ATOM(4,0) }
  | r = 'r8b { lo = ATOM(4,0)   hi = ATOM(4,1) }
  | r = 'r9b { lo = ATOM(4,1)   hi = ATOM(4,1) }
  | r = 'r10b { lo = ATOM(4,2)   hi = ATOM(4,1) }
  | r = 'r11b { lo = ATOM(4,3)   hi = ATOM(4,1) }
  | r = 'r12b { lo = ATOM(4,4)   hi = ATOM(4,1) }
  | r = 'r13b { lo = ATOM(4,5)   hi = ATOM(4,1) }
  | r = 'r14b { lo = ATOM(4,6)   hi = ATOM(4,1) }
  | r = 'r15b { lo = ATOM(4,7)   hi = ATOM(4,1) }
}

;; rfx: regfield contribution ((code&7)<<3)
rfx : <r> <-> <v> where {
  | r = 'rax { v = 0 }
  | r = 'rcx { v = 8 }
  | r = 'rdx { v = 16 }
  | r = 'rbx { v = 24 }
  | r = 'rsp { v = 32 }
  | r = 'rbp { v = 40 }
  | r = 'rsi { v = 48 }
  | r = 'rdi { v = 56 }
  | r = 'r8 { v = 0 }
  | r = 'r9 { v = 8 }
  | r = 'r10 { v = 16 }
  | r = 'r11 { v = 24 }
  | r = 'r12 { v = 32 }
  | r = 'r13 { v = 40 }
  | r = 'r14 { v = 48 }
  | r = 'r15 { v = 56 }
  | r = 'eax { v = 0 }
  | r = 'ecx { v = 8 }
  | r = 'edx { v = 16 }
  | r = 'ebx { v = 24 }
  | r = 'esp { v = 32 }
  | r = 'ebp { v = 40 }
  | r = 'esi { v = 48 }
  | r = 'edi { v = 56 }
  | r = 'r8d { v = 0 }
  | r = 'r9d { v = 8 }
  | r = 'r10d { v = 16 }
  | r = 'r11d { v = 24 }
  | r = 'r12d { v = 32 }
  | r = 'r13d { v = 40 }
  | r = 'r14d { v = 48 }
  | r = 'r15d { v = 56 }
  | r = 'al { v = 0 }
  | r = 'cl { v = 8 }
  | r = 'dl { v = 16 }
  | r = 'bl { v = 24 }
  | r = 'spl { v = 32 }
  | r = 'bpl { v = 40 }
  | r = 'sil { v = 48 }
  | r = 'dil { v = 56 }
  | r = 'r8b { v = 0 }
  | r = 'r9b { v = 8 }
  | r = 'r10b { v = 16 }
  | r = 'r11b { v = 24 }
  | r = 'r12b { v = 32 }
  | r = 'r13b { v = 40 }
  | r = 'r14b { v = 48 }
  | r = 'r15b { v = 56 }
}

;; rnx1: operand needs a REX byte even when v==0x40
rnx1 : <o> <-> <f> where {
  | o = 'bpl { f = 1 }
  | o = 'dil { f = 1 }
  | o = 'r10b { f = 1 }
  | o = 'r11b { f = 1 }
  | o = 'r12b { f = 1 }
  | o = 'r13b { f = 1 }
  | o = 'r14b { f = 1 }
  | o = 'r15b { f = 1 }
  | o = 'r8b { f = 1 }
  | o = 'r9b { f = 1 }
  | o = 'sil { f = 1 }
  | o = 'spl { f = 1 }
  | o = 'r10 { f = 0 }
  | o = 'r11 { f = 0 }
  | o = 'r12 { f = 0 }
  | o = 'r13 { f = 0 }
  | o = 'r14 { f = 0 }
  | o = 'r15 { f = 0 }
  | o = 'r8 { f = 0 }
  | o = 'r9 { f = 0 }
  | o = 'rax { f = 0 }
  | o = 'rbp { f = 0 }
  | o = 'rbx { f = 0 }
  | o = 'rcx { f = 0 }
  | o = 'rdi { f = 0 }
  | o = 'rdx { f = 0 }
  | o = 'rsi { f = 0 }
  | o = 'rsp { f = 0 }
  | o = 'eax { f = 0 }
  | o = 'ebp { f = 0 }
  | o = 'ebx { f = 0 }
  | o = 'ecx { f = 0 }
  | o = 'edi { f = 0 }
  | o = 'edx { f = 0 }
  | o = 'esi { f = 0 }
  | o = 'esp { f = 0 }
  | o = 'r10d { f = 0 }
  | o = 'r11d { f = 0 }
  | o = 'r12d { f = 0 }
  | o = 'r13d { f = 0 }
  | o = 'r14d { f = 0 }
  | o = 'r15d { f = 0 }
  | o = 'r8d { f = 0 }
  | o = 'r9d { f = 0 }
  | o = 'al { f = 0 }
  | o = 'bl { f = 0 }
  | o = 'cl { f = 0 }
  | o = 'dl { f = 0 }
  | o = PAIR(_, _) { f = 0 }
}

rnx : <ops> <-> <f> shape self where {
  | ops = [] { f = 0 }
  | fresh(h, t, fh, ft) {
      ops = PAIR(h, t)   rnx1<h> = fh   rnx<t> = ft   or2<fh, ft> = f
    }
}

;; operand -> code lo3 / hi1 (mem base for 'm, 0 for 'p/'l)
plo8 : <o> <-> <lo8> where {
  | fresh(b, lo) {
      regc<o> = PAIR(lo, _)   c48<lo> = lo8
    }
  | fresh(b, d, lo) {
      o = 'm(b, d)   regc<b> = PAIR(lo, _)   c48<lo> = lo8
    }
}
phi : <o> <-> <hi> where {
  | fresh(d) { regc<o> = PAIR(d, hi) }
  | fresh(b, d) { o = 'm(b, d)   regc<b> = PAIR(_, hi) }
  | fresh(n) { o = 'p(n)   hi = ATOM(4,0) }
  | fresh(n) { o = 'l(n)   hi = ATOM(4,0) }
}

;; c48: nibble atom -> same value as a byte atom
c48 : <n: T[4]> <-> <b> where {
  | n = ATOM(4,0) { b = 0 }
  | n = ATOM(4,1) { b = 1 }
  | n = ATOM(4,2) { b = 2 }
  | n = ATOM(4,3) { b = 3 }
  | n = ATOM(4,4) { b = 4 }
  | n = ATOM(4,5) { b = 5 }
  | n = ATOM(4,6) { b = 6 }
  | n = ATOM(4,7) { b = 7 }
}

;; ---------- field relations ----------

;; rex emission: suppress 0x40 unless an operand needs it
rex_emit : <v, ops> <-> <bs> where {
  | v != ATOM(8,64) { bs = [v] }
  | fresh(f) { v = ATOM(8,64)   rnx<ops> = f   f = 1   bs = [v] }
  | fresh(f) { v = ATOM(8,64)   rnx<ops> = f   f = 0   bs = [] }
}

;; hi bit -> REX.R contribution (*4, as nibble for bplus)
hx4 : <h: T[4]> <-> <v> where {
  | h = ATOM(4,0) { v = ATOM(4,0) }
  | h = ATOM(4,1) { v = ATOM(4,4) }
}

;; rflo: (regfield<<3) + rmlo — 64 declared rows; replaces builtin
;; add (re-pull unsafe) in modrm/modrm-mem emission.
rflo : <rf, lo> <-> <s> where {
  | rf = ATOM(8,0) & lo = ATOM(8,0) { s = 0 }
  | rf = ATOM(8,0) & lo = ATOM(8,1) { s = 1 }
  | rf = ATOM(8,0) & lo = ATOM(8,2) { s = 2 }
  | rf = ATOM(8,0) & lo = ATOM(8,3) { s = 3 }
  | rf = ATOM(8,0) & lo = ATOM(8,4) { s = 4 }
  | rf = ATOM(8,0) & lo = ATOM(8,5) { s = 5 }
  | rf = ATOM(8,0) & lo = ATOM(8,6) { s = 6 }
  | rf = ATOM(8,0) & lo = ATOM(8,7) { s = 7 }
  | rf = ATOM(8,8) & lo = ATOM(8,0) { s = 8 }
  | rf = ATOM(8,8) & lo = ATOM(8,1) { s = 9 }
  | rf = ATOM(8,8) & lo = ATOM(8,2) { s = 10 }
  | rf = ATOM(8,8) & lo = ATOM(8,3) { s = 11 }
  | rf = ATOM(8,8) & lo = ATOM(8,4) { s = 12 }
  | rf = ATOM(8,8) & lo = ATOM(8,5) { s = 13 }
  | rf = ATOM(8,8) & lo = ATOM(8,6) { s = 14 }
  | rf = ATOM(8,8) & lo = ATOM(8,7) { s = 15 }
  | rf = ATOM(8,16) & lo = ATOM(8,0) { s = 16 }
  | rf = ATOM(8,16) & lo = ATOM(8,1) { s = 17 }
  | rf = ATOM(8,16) & lo = ATOM(8,2) { s = 18 }
  | rf = ATOM(8,16) & lo = ATOM(8,3) { s = 19 }
  | rf = ATOM(8,16) & lo = ATOM(8,4) { s = 20 }
  | rf = ATOM(8,16) & lo = ATOM(8,5) { s = 21 }
  | rf = ATOM(8,16) & lo = ATOM(8,6) { s = 22 }
  | rf = ATOM(8,16) & lo = ATOM(8,7) { s = 23 }
  | rf = ATOM(8,24) & lo = ATOM(8,0) { s = 24 }
  | rf = ATOM(8,24) & lo = ATOM(8,1) { s = 25 }
  | rf = ATOM(8,24) & lo = ATOM(8,2) { s = 26 }
  | rf = ATOM(8,24) & lo = ATOM(8,3) { s = 27 }
  | rf = ATOM(8,24) & lo = ATOM(8,4) { s = 28 }
  | rf = ATOM(8,24) & lo = ATOM(8,5) { s = 29 }
  | rf = ATOM(8,24) & lo = ATOM(8,6) { s = 30 }
  | rf = ATOM(8,24) & lo = ATOM(8,7) { s = 31 }
  | rf = ATOM(8,32) & lo = ATOM(8,0) { s = 32 }
  | rf = ATOM(8,32) & lo = ATOM(8,1) { s = 33 }
  | rf = ATOM(8,32) & lo = ATOM(8,2) { s = 34 }
  | rf = ATOM(8,32) & lo = ATOM(8,3) { s = 35 }
  | rf = ATOM(8,32) & lo = ATOM(8,4) { s = 36 }
  | rf = ATOM(8,32) & lo = ATOM(8,5) { s = 37 }
  | rf = ATOM(8,32) & lo = ATOM(8,6) { s = 38 }
  | rf = ATOM(8,32) & lo = ATOM(8,7) { s = 39 }
  | rf = ATOM(8,40) & lo = ATOM(8,0) { s = 40 }
  | rf = ATOM(8,40) & lo = ATOM(8,1) { s = 41 }
  | rf = ATOM(8,40) & lo = ATOM(8,2) { s = 42 }
  | rf = ATOM(8,40) & lo = ATOM(8,3) { s = 43 }
  | rf = ATOM(8,40) & lo = ATOM(8,4) { s = 44 }
  | rf = ATOM(8,40) & lo = ATOM(8,5) { s = 45 }
  | rf = ATOM(8,40) & lo = ATOM(8,6) { s = 46 }
  | rf = ATOM(8,40) & lo = ATOM(8,7) { s = 47 }
  | rf = ATOM(8,48) & lo = ATOM(8,0) { s = 48 }
  | rf = ATOM(8,48) & lo = ATOM(8,1) { s = 49 }
  | rf = ATOM(8,48) & lo = ATOM(8,2) { s = 50 }
  | rf = ATOM(8,48) & lo = ATOM(8,3) { s = 51 }
  | rf = ATOM(8,48) & lo = ATOM(8,4) { s = 52 }
  | rf = ATOM(8,48) & lo = ATOM(8,5) { s = 53 }
  | rf = ATOM(8,48) & lo = ATOM(8,6) { s = 54 }
  | rf = ATOM(8,48) & lo = ATOM(8,7) { s = 55 }
  | rf = ATOM(8,56) & lo = ATOM(8,0) { s = 56 }
  | rf = ATOM(8,56) & lo = ATOM(8,1) { s = 57 }
  | rf = ATOM(8,56) & lo = ATOM(8,2) { s = 58 }
  | rf = ATOM(8,56) & lo = ATOM(8,3) { s = 59 }
  | rf = ATOM(8,56) & lo = ATOM(8,4) { s = 60 }
  | rf = ATOM(8,56) & lo = ATOM(8,5) { s = 61 }
  | rf = ATOM(8,56) & lo = ATOM(8,6) { s = 62 }
  | rf = ATOM(8,56) & lo = ATOM(8,7) { s = 63 }
}

;; modrm mod=11: 0xC0 + regfield + rmlo   (rf, lo as byte atoms)
mrm_rr : <rf, lo> <-> <m> where {
  | fresh(s) { rflo<rf, lo> = s   m = ATOM(8, s+0xC0) }
}

;; modrm rip: mod=00 rm=101
mrm_rip : <rf> <-> <m> where {
  | fresh(s) { rflo<rf, ATOM(8,5)> = s   m = s }
}

;; mem_f<rf, base, dnl> = PAIR(head, dispbytes)
;; rf = regfield<<3 (byte atom); exclusive cases mirror _mem_modrm:
;;   disp0 & lo!=5 -> mod00 ; disp0 & lo==5 -> mod01 disp8=0
;;   fits-i8 -> mod01 disp8 ; else mod10 disp32 ; SIB iff lo==4.
mem_f : <rf, base, dnl> <-> <PAIR(mh, db)> where {
  | fresh(lo, hi, s, s0, z) {
      regc<base> = PAIR(lo, hi)   nlz<dnl> = _
      lo != ATOM(4,4)   lo != ATOM(4,5)
      c48<lo> = s0   rflo<rf, s0> = s
      mh = [s]   db = []
    }
  | fresh(lo, hi, s, s0, z) {
      regc<base> = PAIR(lo, hi)   nlz<dnl> = _
      lo = ATOM(4,4)
      c48<lo> = s0   rflo<rf, s0> = s
      mh = [s, 0x24]   db = []
    }
  | fresh(lo, hi, s, s0, z) {
      regc<base> = PAIR(lo, hi)   nlz<dnl> = _
      lo = ATOM(4,5)
      c48<lo> = s0   rflo<rf, s0> = s
      mh = [ATOM(8, s+64)]   db = [0]
    }
  | fresh(lo, hi, s, s0, d0, d1, sh, d8) {
      regc<base> = PAIR(lo, hi)
      nlzf<dnl> = 0   se8f<dnl> = 1
      lo != ATOM(4,4)
      c48<lo> = s0   rflo<rf, s0> = s
      dnl = PAIR(d0, PAIR(d1, _))
      shl4<d1> = sh   bplus<sh, d0> = d8
      mh = [ATOM(8, s+64)]   db = [d8]
    }
  | fresh(lo, hi, s, s0, d0, d1, sh, d8) {
      regc<base> = PAIR(lo, hi)
      nlzf<dnl> = 0   se8f<dnl> = 1
      lo = ATOM(4,4)
      c48<lo> = s0   rflo<rf, s0> = s
      dnl = PAIR(d0, PAIR(d1, _))
      shl4<d1> = sh   bplus<sh, d0> = d8
      mh = [ATOM(8, s+64), 0x24]   db = [d8]
    }
  | fresh(lo, hi, s, s0, db4) {
      regc<base> = PAIR(lo, hi)
      nlzf<dnl> = 0   se8f<dnl> = 0
      lo != ATOM(4,4)
      c48<lo> = s0   rflo<rf, s0> = s
      nibs2bytes<dnl> = db4
      mh = [ATOM(8, s+128)]   db = db4
    }
  | fresh(lo, hi, s, s0, db4) {
      regc<base> = PAIR(lo, hi)
      nlzf<dnl> = 0   se8f<dnl> = 0
      lo = ATOM(4,4)
      c48<lo> = s0   rflo<rf, s0> = s
      nibs2bytes<dnl> = db4
      mh = [ATOM(8, s+128), 0x24]   db = db4
    }
}

;; immediates: 'i(nl) — width by nl length
im8 : <nl> <-> <bs> where {
  | fresh(n0, n1, sh, b) {
      nl = PAIR(n0, PAIR(n1, _))
      shl4<n1> = sh   bplus<sh, n0> = b   bs = [b]
    }
}
im32 : <nl> <-> <bs> where { nibs2bytes<nl> = bs }
im64 : <nl> <-> <bs> where { nibs2bytes<nl> = bs }

;; relfix<o, labs, acc, pcva8> — trailing rel32:
;;   end = pcva + len(acc) + 4 ;  disp = target - end
relfix : <o, labs, acc, pcva8> <-> <db> where {
  | fresh(n, off, t8, l8, e1, end, dnl) {
      o = 'l(n)
      assoc<n, labs> = off
      nl_add<[ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,3), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)], off, ATOM(4,0)> = t8
      len_nl<acc> = l8
      nl_add<pcva8, l8, ATOM(4,0)> = e1
      nl_add<e1, [ATOM(4,4), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)], ATOM(4,0)> = end
      nibble_sub<t8, end, ATOM(4,0)> = dnl
      nibs2bytes<dnl> = db
    }
  | fresh(n, t8, l8, e1, end, dnl) {
      o = 'p(n)
      symtab<n> = t8
      len_nl<acc> = l8
      nl_add<pcva8, l8, ATOM(4,0)> = e1
      nl_add<e1, [ATOM(4,4), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)], ATOM(4,0)> = end
      nibble_sub<t8, end, ATOM(4,0)> = dnl
      nibs2bytes<dnl> = db
    }
}

;; ---------- declared layout (target_pe64.symbols) ----------
symtab : <name> <-> <nl8> where {
  | name = 'c_comp { nl8 = [ATOM(4,8), ATOM(4,10), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_dup { nl8 = [ATOM(4,8), ATOM(4,9), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_konst { nl8 = [ATOM(4,0), ATOM(4,9), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_left { nl8 = [ATOM(4,8), ATOM(4,11), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_norm { nl8 = [ATOM(4,8), ATOM(4,8), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_right { nl8 = [ATOM(4,0), ATOM(4,12), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_s { nl8 = [ATOM(4,0), ATOM(4,11), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'c_swap { nl8 = [ATOM(4,0), ATOM(4,10), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'ds { nl8 = [ATOM(4,0), ATOM(4,3), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'herr { nl8 = [ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'hin { nl8 = [ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'hout { nl8 = [ATOM(4,8), ATOM(4,0), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'iat_ExitProcess { nl8 = [ATOM(4,8), ATOM(4,7), ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'iat_GetStdHandle { nl8 = [ATOM(4,8), ATOM(4,5), ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'iat_ReadFile { nl8 = [ATOM(4,0), ATOM(4,6), ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'iat_VirtualAlloc { nl8 = [ATOM(4,0), ATOM(4,7), ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'iat_WriteFile { nl8 = [ATOM(4,8), ATOM(4,6), ATOM(4,0), ATOM(4,1), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'irstart { nl8 = [ATOM(4,0), ATOM(4,8), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'nalloc { nl8 = [ATOM(4,8), ATOM(4,2), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'nread { nl8 = [ATOM(4,8), ATOM(4,1), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'nw { nl8 = [ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'permend { nl8 = [ATOM(4,8), ATOM(4,7), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
  | name = 'scratch { nl8 = [ATOM(4,8), ATOM(4,3), ATOM(4,0), ATOM(4,2), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)] }
}

;; ---------- generated rex rels ----------
rex_B0 : <vb, o0> <-> <bs> where {
  | fresh(v1, v2) {
      phi<o0> = v1
      bplus<vb, v1> = v2
      rex_emit<v2, [o0]> = bs
    }
}

rex_B0_R1 : <vb, o0, o1> <-> <bs> where {
  | fresh(v1, v2, v3, v4, v5) {
      phi<o0> = v1
      bplus<vb, v1> = v2
      phi<o1> = v3
      hx4<v3> = v5
      bplus<v2, v5> = v4
      rex_emit<v4, [o0, o1]> = bs
    }
}

rex_w : <vb> <-> <bs> where {
  | fresh(d) { rex_emit<vb, []> = bs }
}

rex_w_B0 : <vb, o0> <-> <bs> where {
  | fresh(v1, v2) {
      phi<o0> = v1
      bplus<vb, v1> = v2
      rex_emit<v2, [o0]> = bs
    }
}

rex_w_B0_R1 : <vb, o0, o1> <-> <bs> where {
  | fresh(v1, v2, v3, v4, v5) {
      phi<o0> = v1
      bplus<vb, v1> = v2
      phi<o1> = v3
      hx4<v3> = v5
      bplus<v2, v5> = v4
      rex_emit<v4, [o0, o1]> = bs
    }
}

rex_w_R0 : <vb, o0> <-> <bs> where {
  | fresh(v1, v2, v3) {
      phi<o0> = v1
      hx4<v1> = v3
      bplus<vb, v3> = v2
      rex_emit<v2, [o0]> = bs
    }
}

rex_w_R0_B1 : <vb, o0, o1> <-> <bs> where {
  | fresh(v1, v2, v3, v4, v5) {
      phi<o0> = v1
      hx4<v1> = v3
      bplus<vb, v3> = v2
      phi<o1> = v4
      bplus<v2, v4> = v5
      rex_emit<v5, [o0, o1]> = bs
    }
}

rex_w_R1 : <vb, o1> <-> <bs> where {
  | fresh(v1, v2, v3) {
      phi<o1> = v1
      hx4<v1> = v3
      bplus<vb, v3> = v2
      rex_emit<v2, [o1]> = bs
    }
}

rex_w_R1_B0 : <vb, o0, o1> <-> <bs> where {
  | fresh(v1, v2, v3, v4, v5) {
      phi<o1> = v1
      hx4<v1> = v3
      bplus<vb, v3> = v2
      phi<o0> = v4
      bplus<v2, v4> = v5
      rex_emit<v5, [o0, o1]> = bs
    }
}

;; ---------- enc2: form x alternative -> clause ----------
enc2 : <op, labs, pc8> <-> <bytes> where {
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13) {
      op = 'op('mov_r64_imm, o0, o1)
      o1 = 'i(v1)
      i32f<v1> = 1
      rex_w_B0<ATOM(8,72), o0> = v3
      append<[], v3> = v4
      v5 = [ATOM(8,199)]
      append<v4, v5> = v6
      plo8<o0> = v8
      mrm_rr<ATOM(8,0), v8> = v9
      v7 = [v9]
      append<v6, v7> = v10
      o1 = 'i(v12)
      im32<v12> = v11
      append<v10, v11> = v13
      bytes = v13
    }
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11) {
      op = 'op('mov_r64_imm, o0, o1)
      o1 = 'i(v1)
      i32f<v1> = 0
      rex_w_B0<ATOM(8,72), o0> = v3
      append<[], v3> = v4
      regc<o0> = PAIR(v6, _)
      bplus<ATOM(8,184), v6> = v7
      v5 = [v7]
      append<v4, v5> = v8
      o1 = 'i(v10)
      im64<v10> = v9
      append<v8, v9> = v11
      bytes = v11
    }
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10) {
      op = 'op('mov_r64_r64, o0, o1)
      rex_w_R1_B0<ATOM(8,72), o0, o1> = v2
      append<[], v2> = v3
      v4 = [ATOM(8,137)]
      append<v3, v4> = v5
      rfx<o1> = v7
      plo8<o0> = v8
      mrm_rr<v7, v8> = v9
      v6 = [v9]
      append<v5, v6> = v10
      bytes = v10
    }
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13) {
      op = 'op('mov_r64_m64, o0, o1)
      rex_w_R0_B1<ATOM(8,72), o0, o1> = v2
      append<[], v2> = v3
      v4 = [ATOM(8,139)]
      append<v3, v4> = v5
      rfx<o0> = v7
      o1 = 'm(v8, v9)
      mem_f<v7, v8, v9> = PAIR(v6, v10)
      append<v5, v6> = v11
      append<v11, v10> = v13
      bytes = v13
    }
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13) {
      op = 'op('mov_m64_r64, o0, o1)
      rex_w_B0_R1<ATOM(8,72), o0, o1> = v2
      append<[], v2> = v3
      v4 = [ATOM(8,137)]
      append<v3, v4> = v5
      rfx<o1> = v7
      o0 = 'm(v8, v9)
      mem_f<v7, v8, v9> = PAIR(v6, v10)
      append<v5, v6> = v11
      append<v11, v10> = v13
      bytes = v13
    }
  | fresh(o0, o1, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12) {
      op = 'op('mov_r64_rip, o0, o1)
      nl_add<[ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,3), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)], pc8, ATOM(4,0)> = v1
      rex_w_R0<ATOM(8,72), o0> = v3
      append<[], v3> = v4
      v5 = [ATOM(8,139)]
      append<v4, v5> = v6
      rfx<o0> = v8
      mrm_rip<v8> = v9
      v7 = [v9]
