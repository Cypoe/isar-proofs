;; ---------- assembler ----------

;; pass1: label -> section-offset rows (nl8); insns advance pc by
;; enc2_len — label-independent by construction.
pass1 : <ops, pc8> <-> <labs> shape self where {
  | ops = [] { labs = [] }
  | fresh(o, n, rest, lb) {
      ops = PAIR(o, rest)   o = 'label(n)
      pass1<rest, pc8> = lb
      labs = PAIR(PAIR(n, pc8), lb)
    }
  | fresh(o, rest, n8, pc2, lb) {
      ops = PAIR(o, rest)   o = PAIR('op, _)
      enc2_len<o> = n8
      nl_add<pc8, n8, ATOM(4,0)> = pc2
      pass1<rest, pc2> = lb
      labs = lb
    }
}

assemble2 : <ops, labs, pc8> <-> <bytes> shape self where {
  | ops = [] { bytes = [] }
  | fresh(o, rest, rb) {
      ops = PAIR(o, rest)   o = 'label(_)
      assemble2<rest, labs, pc8> = rb
      bytes = rb
    }
  | fresh(o, rest, eb, n8, pc2, rb) {
      ops = PAIR(o, rest)   o = PAIR('op, _)
      enc2<o, labs, pc8> = eb
      enc2_len<o> = n8
      nl_add<pc8, n8, ATOM(4,0)> = pc2
      assemble2<rest, labs, pc2> = rb
      append<eb, rb> = bytes
    }
}

assemble : <ops> <-> <bytes> where {
  | fresh(labs) {
      pass1<ops, [ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)]> = labs
      assemble2<ops, labs, [ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0), ATOM(4,0)]> = bytes
    }
}
