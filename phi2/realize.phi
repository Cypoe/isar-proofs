;; realize.plex — the fold over spec.maps.  A spec is data:
;;   'spec(src, maps, qmaps, regime, ctx)
;;
;;   maps   : ordered spine of map names — the fold order
;;   qmaps  : alist PAIR(name, mapT) — resolution stays data,
;;            via assoc (std/lists_member_assoc)
;;   mapT   : 'map(menv, entry) — menv = enc env-alist of defs
;;            (the map bundle's graph as data), entry = raw sym;
;;            uniform map signature entry<x> = y (a quotient map
;;            on artifacts: one term in, one term out)
;;   regime : observation regime term — carried, bound by cogen,
;;            not consumed by the fold
;;   ctx    : machine context (target, loader family)
;; uses: std/lists_member_assoc, eval
;; apply runs the map through the CORPUS eval (same enc domain as
;; eval.phi): builds a 'call goal with a caller-side out-var
;; ('var 0 — eval's inst allocates ids >= n, so 0 never collides),
;; evals it in the map's own env, reifies through the returned
;; subst.  Missing maps / missing entries fail as empty streams —
;; declared-not-realized, never a fallback.

realize : <spec> <-> <out> where {
  fresh (src, maps, qmaps, rest) {
    spec = 'spec(src, maps, qmaps, rest)
    rfold<qmaps, maps, src> = out
  }
}

rfold : <qmaps, maps, acc> <-> <out> shape self where {
  | maps = [] { out = acc }
  | fresh (mn, rest, q, m2) {
      maps = [mn|rest]
      assoc<mn, qmaps> = q
      apply<q, acc> = m2
      rfold<qmaps, rest, m2> = out
    }
}

apply : <mapT, ain> <-> <aout> where {
  fresh (menv, entry, ov, goal, res, s2) {
    mapT = 'map(menv, entry)
    ov = 'var(0)
    goal = 'call('sym(entry), [ain], ov)
    eval<menv, goal, [], 1> = res
    res = [s2|_]
    reify<ov, s2> = aout
  }
}
