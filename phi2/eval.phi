;; eval.plex — the evaluator as a corpus program.  Layers 0-1:
;; the substitution machine, instantiation (alpha-renaming), and
;; clause-iteration eval — all as data over enc terms.
;;
;; Encoding contract (enc), in 'tag sugar:
;;   ("atom",b,v)  -> 'atom(ATOM(8,b), ATOM(8,v))
;;   ("var",i)     -> 'var(i)            ;; i = fresh id
;;   ("nvar", 'x)  -> 'nvar('x)          ;; name-var, AST
;;   ("pair",a,b)  -> 'pair(a, b)
;;   ("sym",n)     -> 'sym('n)
;;   NIL           -> 'atom(0, 0)        ;; PAIR('atom,PAIR(0,0))
;;
;; goals:  'unify(a, b)
;;         'call(nameSym, argsList, outT)
;; def:    'def(inPatList, outPat, clauseList)
;; clause: 'clause(goalList)
;; env:    PAIR-spine of PAIR(nameSym, defTerm)
;; subst:  PAIR-spine of PAIR(ATOM(8,id), encTerm), newest first
;; ren:    PAIR-spine of PAIR(nameSym, ATOM(8,id))
;;
;; Exclusivity: disjunction explores every matching clause, so
;; overlapping patterns must be exclusive by construction — guards
;; only test sig vars; all destructuring happens under fresh in
;; goals; the unify_w matrix cases u/v by tag so each pair hits
;; exactly one clause.
;; uses: std/arith_peano_succ

;; --- atom counter for fresh ids ---
next_id : <n: T[8]> <-> <ATOM(8, n+1)>

;; --- 'adyn resolution: enc'd ATOM(var±k) dynamic exprs.  After
;;     walk, 'adyn(base, delta) with both operands walked to
;;     'atom(PAIR(b,v)) evaluates to 'atom(PAIR(b, v+delta)) —
;;     arithmetic is the corpus add on the raw T[8] slots. ---
adyn_res : <t, s> <-> <r> where {
  | fresh (bt, dt, wb, wd, bi, vi, di, dvi, nv2) {
      t = 'adyn(bt, dt)
      walk<bt, s> = wb
      walk<dt, s> = wd
      wb = 'atom([bi|vi])
      wd = 'atom([di|dvi])
      add<vi, dvi> = nv2
      r = 'atom([bi|nv2])
    }
  | fresh (hit) {
      RUN(adyn_probe<t>, 1) = hit
      hit = []
      r = t
    }
}
adyn_probe : <t> <-> <hit> where {
  | fresh (bt, dt) { t = 'adyn(bt, dt)  hit = 'yes }
}

;; --- subst lookup: first binding wins; unbound is a value ---
subst_lookup : <k, lst> <-> <r> shape self where {
  | fresh (v, rest) {
      lst = [[k|v]|rest]
      r = 'bound(v)
    }
  | fresh (k2, rest) {
      lst = [[k2|_]|rest]
      k != k2
      subst_lookup<k, rest> = r
    }
  | lst = [] { r = 'unbound }
}

;; --- walk: chase var bindings through the subst ---
walk : <t, s> <-> <r> shape self where {
  | fresh (i, b) {
      t = 'var(i)
      subst_lookup<i, s> = b
      walk_res<b, t, s> = r
    }
  | fresh (hit) {
      nonvar<t> = hit
      hit = 'yes
      r = t
    }
}
walk_res : <b, t, s> <-> <r> shape self where {
  | fresh (v) {
      b = 'bound(v)
      walk<v, s> = r
    }
  | b = 'unbound { r = t }
}

;; --- open-tag domain: every enc node is a PAIR spine over raw
;;     leaves.  'var is the ONLY subst-driven tag — probes are
;;     absence-based, not tag-enumerated, so goal nodes ('call,
;;     'unify, 'def, 'clause, ...) flow through the same machinery
;;     as value nodes.  pair_probe fires on ANY pair cell ('var
;;     included); nonvar is its complement. ---
var_probe : <t> <-> <hit> where {
  | fresh (i) { t = 'var(i)  hit = 'yes }
}
nonvar : <t> <-> <hit> where {
  | fresh (res) {
      RUN(var_probe<t>, 1) = res
      res = []
      hit = 'yes
    }
}
pair_probe : <t> <-> <hit> where {
  | fresh (a, b) { t = [a|b]  hit = 'yes }
}

;; --- unify on the encoded domain: the triangular-subst mgu.
;;     unify_w cases (u,v) by tag — exactly one clause per pair. ---
unify_enc : <u, v, s> <-> <s2> shape self where {
  | fresh (uw, vw, u2, v2) {
      walk<u, s> = uw
      walk<v, s> = vw
      adyn_res<uw, s> = u2
      adyn_res<vw, s> = v2
      unify_w<u2, v2, s> = s2
    }
}
;; --- unify on the encoded domain: the triangular-subst mgu.
;;     Cases by SHAPE not tag: 'var binds; any two pair-cells
;;     decompose structurally ('pair/'call/'unify/'def/'nvar —
;;     the open tag set); non-pair non-var leaves equal-compare.
;;     Exclusivity: 'var is a pair cell, so the structural and
;;     leaf rows both guard on nonvar. ---
unify_w : <u, v, s> <-> <s2> shape self where {
  | fresh (i) {
      u = 'var(i)
      v = 'var(i)
      s2 = s
    }
  | fresh (i, j) {
      u = 'var(i)
      v = 'var(j)
      i != j
      s2 = [[i|v]|s]
    }
  | fresh (i) {
      u = 'var(i)
      nonvar<v> = 'yes
      s2 = [[i|v]|s]
    }
  | fresh (i) {
      v = 'var(i)
      nonvar<u> = 'yes
      s2 = [[i|u]|s]
    }
  | fresh (a1, b1, a2, b2, s1) {
      nonvar<u> = 'yes
      nonvar<v> = 'yes
      u = [a1|b1]
      v = [a2|b2]
      unify_enc<a1, a2, s> = s1
      unify_enc<b1, b2, s1> = s2
    }
  | fresh (h1, h2) {
      nonvar<u> = 'yes
      nonvar<v> = 'yes
      RUN(pair_probe<u>, 1) = h1
      RUN(pair_probe<v>, 1) = h2
      h1 = []
      h2 = []
      u = v
      s2 = s
    }
}

;; --- env_find: defs as data — PAIR(name, def) spine; absent
;;     name = stream failure (a refusal) ---
env_find : <name, env> <-> <def> shape self where {
  | fresh (d2, rest) {
      env = [[name|d2]|rest]
      def = d2
    }
  | fresh (e, rest) {
      env = [e|rest]
      env_find<name, rest> = def
    }
}

;; --- ren_find / ren_fc: the renaming alist with lazy
;;     find-or-create — rel_eval's ren dict, as data ---
ren_find : <name, ren> <-> <id> shape self where {
  | fresh (id2, rest) {
      ren = [[name|id2]|rest]
      id = id2
    }
  | fresh (e, rest) {
      ren = [e|rest]
      ren_find<name, rest> = id
    }
}
ren_fc : <name, ren, n> <-> <o> where {
  | fresh (res) {
      RUN(ren_find<name, ren>, 1) = res
      ren_fc_res<res, name, ren, n> = o
    }
}
ren_fc_res : <res, name, ren, n> <-> <o> where {
  | fresh (id) {
      res = [id|_]
      o = [id|[ren|n]]
    }
  | fresh (n2) {
      res = []
      next_id<n> = n2
      o = [n|[[[name|n]|ren]|n2]]
    }
}

;; --- inst: alpha-rename a clause's 'nvar terms to fresh 'var
;;     ids.  o = PAIR(ren2, PAIR(n2, node2)). ---
;; --- inst: alpha-rename 'nvar -> fresh 'var through the OPEN
;;     tag domain.  Three shapes, not tag rows: 'nvar renames,
;;     any other pair cell recurses structurally (covers
;;     'pair/'unify/'call/'cmp/'run/'adyn/'clause/future tags),
;;     non-pair leaves pass. ---
nvar_probe : <t> <-> <hit> where {
  | fresh (x) { t = 'nvar(x)  hit = 'yes }
}
inst : <node, ren, n> <-> <o> shape self where {
  | fresh (x, id, r2, n2) {
      node = 'nvar(x)
      ren_fc<x, ren, n> = [id|[r2|n2]]
      o = [r2|[n2|'var(id)]]
    }
  | fresh (a, b, r1, n1, a2, r2, n2, b2, res) {
      RUN(nvar_probe<node>, 1) = res
      res = []
      node = [a|b]
      inst<a, ren, n> = [r1|[n1|a2]]
      inst<b, r1, n1> = [r2|[n2|b2]]
      o = [r2|[n2|[a2|b2]]]
    }
  | fresh (res, h) {
      RUN(nvar_probe<node>, 1) = res
      res = []
      RUN(pair_probe<node>, 1) = h
      h = []
      o = [ren|[n|node]]
    }
}
inst_list : <lst, ren, n> <-> <o> shape self where {
  | lst = [] { o = [ren|[n|[]]] }
  | fresh (h, rest, r1, n1, h2, r2, n2, rest2) {
      lst = [h|rest]
      inst<h, ren, n> = [r1|[n1|h2]]
      inst_list<rest, r1, n1> = [r2|[n2|rest2]]
      o = [r2|[n2|[h2|rest2]]]
    }
}

;; --- reify: deep walk — the answer as a term, not a spine ---
reify : <t, s> <-> <r> shape self where {
  | fresh (w) {
      walk<t, s> = w
      reify_w<w, s> = r
    }
}
reify_w : <w, s> <-> <r> shape self where {
  | fresh (a, b, ra, rb) {
      ;; generic pair-cell spine — every enc node ('pair/'call/
      ;; 'var/'def/...) reifies by structure, not by tag
      w = [a|b]
      reify<a, s> = ra
      reify<b, s> = rb
      r = [ra|rb]
    }
  | fresh (h) {
      RUN(pair_probe<w>, 1) = h
      h = []
      r = w
    }
}

;; --- term equality probe for 'cmp: post-walk operands unify ---
eq_t : <a, b> <-> <hit> where {
  | a = b { hit = 'yes }
}

;; --- 'run out marker: collected stream -> enc probe value ---
run_res : <res, ot, s> <-> <s3> where {
  | res = [] { unify_enc<ot, 'atom(0, 0), s> = s3 }
  | fresh (h) {
      res = [h|_]
      unify_enc<ot, 'sym('nonempty), s> = s3
    }
}

;; --- eval: goals are enc terms; o = PAIR(s2, n2) ---
eval : <env, goal, s, n> <-> <o> shape self where {
  | fresh (a, b, s2) {
      goal = 'unify(a, b)
      unify_enc<a, b, s> = s2
      o = [s2|n]
    }
  | fresh (a, b, wa, wb, res) {
      ;; 'cmp('neq, a, b): the guard — succeeds iff walked terms
      ;; DON'T unify; absence-probe keeps it exclusive
      goal = 'cmp('neq, a, b)
      walk<a, s> = wa
      walk<b, s> = wb
      RUN(eq_t<wa, wb>, 1) = res
      res = []
      o = [s|n]
    }
  | fresh (a, b, wa, wb, res) {
      ;; 'cmp('eq, a, b): walked terms DO unify
      goal = 'cmp('eq, a, b)
      walk<a, s> = wa
      walk<b, s> = wb
      RUN(eq_t<wa, wb>, 1) = res
      res = ['yes|_]
      o = [s|n]
    }
  | fresh (g2, n2, ot, res, s3) {
      ;; 'run(g, k, outT): meta-level stream->list IS the surface
      ;; RUN over the corpus eval — the stepper materializes.
      ;; outT binds 'atom(0,0) (empty) or 'sym('nonempty) — the
      ;; probe form.  Carrying the raw stream itself is a 'data
      ;; axis: results are raw [s|n] spines, outside the closed
      ;; enc domain — named, not smuggled.
      goal = 'run(g2, n2, ot)
      RUN(eval<env, g2, s, n>, 1) = res
      run_res<res, ot, s> = s3
      o = [s3|n]
    }
  | fresh (nm, at, ot, def) {
      ;; keys are 'sym NODES (not raw syms): level-agnostic —
      ;; corpus env_find unifies them as terms at L1; the enc'd
      ;; copy does 'sym-'sym unify_w at L2.  A raw sym is not an
      ;; enc-domain value and could never match there.
      goal = 'call(nm, at, ot)
      env_find<nm, env> = def
      eval_call<env, def, at, ot, s, n> = o
    }
}
eval_call : <env, def, at, ot, s, n> <-> <o> shape self where {
  | fresh (ins, outP, clauses) {
      def = 'def(ins, outP, clauses)
      eval_clauses<env, clauses, ins, outP, at, ot, s, n> = o
    }
}
eval_clauses : <env, clauses, ins, outP, at, ot, s, n> <-> <o>
    shape self where {
  | fresh (cl, rest) {
      clauses = [cl|rest]
      eval_clause<env, cl, ins, outP, at, ot, s, n> = o
    }
  | fresh (cl, rest) {
      clauses = [cl|rest]
      eval_clauses<env, rest, ins, outP, at, ot, s, n> = o
    }
}
eval_clause : <env, cl, ins, outP, at, ot, s, n> <-> <o> shape self where {
  | fresh (goals, r1, n1, ins2, r2, n2, outP2,
           r3, n3, goals2, s1, s3) {
      cl = 'clause(goals)
      inst_list<ins, [], n> = [r1|[n1|ins2]]
      inst<outP, r1, n1> = [r2|[n2|outP2]]
      inst_list<goals, r2, n2> = [r3|[n3|goals2]]
      unify_args<ins2, at, s> = s1
      unify_enc<ot, outP2, s1> = s3
      eval_body<env, goals2, s3, n3> = o
    }
}
eval_body : <env, goals, s, n> <-> <o> shape self where {
  | goals = [] { o = [s|n] }
  | fresh (g, rest, s1, n1) {
      goals = [g|rest]
      eval<env, g, s, n> = [s1|n1]
      eval_body<env, rest, s1, n1> = o
    }
}
unify_args : <ins, at, s> <-> <s1> shape self where {
  | ins = [] & at = [] { s1 = s }
  | fresh (p, prest, a, arest, s0) {
      ins = [p|prest]
      at = [a|arest]
      unify_enc<p, a, s> = s0
      unify_args<prest, arest, s0> = s1
    }
}
