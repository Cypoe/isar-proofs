;; eval.plex — the evaluator as a corpus program.  Layers 0-1:
;; the substitution machine, instantiation (alpha-renaming), and
;; clause-iteration eval — all as data over enc terms.
;;
;; Encoding contract (enc):
;;   ("atom",b,v)  -> PAIR('atom, PAIR(ATOM(8,b), ATOM(8,v)))
;;   ("var",i)     -> PAIR('var,  ATOM(8,i))        ;; i = fresh id
;;   ("nvar", 'x)  -> PAIR('nvar, 'x)               ;; name-var, AST
;;   ("pair",a,b)  -> PAIR('pair, PAIR(a, b))
;;   ("sym",n)     -> PAIR('sym,  'n)
;;   NIL           -> PAIR('atom, PAIR(0,0))        ;; atom(0,0)
;;
;; goals:  ('unify, PAIR(a,b))
;;         ('call, PAIR(nameSym, PAIR(argsList, outT)))
;; def:    PAIR('def, PAIR(inPatList, PAIR(outPat, clauseList)))
;; clause: PAIR('clause, goalList)
;; env:    PAIR-spine of PAIR(nameSym, defTerm)
;; subst:  PAIR-spine of PAIR(ATOM(8,id), encTerm), newest first
;; ren:    PAIR-spine of PAIR(nameSym, ATOM(8,id))
;;
;; Exclusivity: disjunction explores every matching clause, so
;; overlapping patterns must be exclusive by construction — guards
;; only test sig vars; all destructuring happens under fresh in
;; goals; the unify_w matrix cases u/v by tag so each pair hits
;; exactly one clause.

;; --- atom counter for fresh ids ---
next_id : <n: T[8]> <-> <ATOM(8, n+1)>

;; --- subst lookup: first binding wins; unbound is a value ---
subst_lookup : <k, lst> <-> <r> shape self where {
  | fresh (v, rest) {
      lst = PAIR(PAIR(k, v), rest)
      r = PAIR('bound, v)
    }
  | fresh (k2, rest) {
      lst = PAIR(PAIR(k2, _), rest)
      k != k2
      subst_lookup<k, rest> = r
    }
  | lst = [] { r = 'unbound }
}

;; --- walk: chase var bindings through the subst ---
walk : <t, s> <-> <r> shape self where {
  | fresh (i, b) {
      t = PAIR('var, i)
      subst_lookup<i, s> = b
      walk_res<b, t, s> = r
    }
  | fresh (c) {
      t = PAIR('atom, c)
      r = t
    }
  | fresh (c) {
      t = PAIR('pair, c)
      r = t
    }
  | fresh (c) {
      t = PAIR('sym, c)
      r = t
    }
}
walk_res : <b, t, s> <-> <r> shape self where {
  | fresh (v) {
      b = PAIR('bound, v)
      walk<v, s> = r
    }
  | b = 'unbound { r = t }
}

;; --- unify on the encoded domain: the triangular-subst mgu.
;;     unify_w cases (u,v) by tag — exactly one clause per pair. ---
unify_enc : <u, v, s> <-> <s2> shape self where {
  | fresh (uw, vw) {
      walk<u, s> = uw
      walk<v, s> = vw
      unify_w<uw, vw, s> = s2
    }
}
unify_w : <u, v, s> <-> <s2> shape self where {
  | fresh (i) {
      u = PAIR('var, i)
      v = PAIR('var, i)
      s2 = s
    }
  | fresh (i, j) {
      u = PAIR('var, i)
      v = PAIR('var, j)
      i != j
      s2 = PAIR(PAIR(i, v), s)
    }
  | fresh (i, c) {
      u = PAIR('var, i)
      v = PAIR('atom, c)
      s2 = PAIR(PAIR(i, v), s)
    }
  | fresh (i, c) {
      u = PAIR('var, i)
      v = PAIR('pair, c)
      s2 = PAIR(PAIR(i, v), s)
    }
  | fresh (i, c) {
      u = PAIR('var, i)
      v = PAIR('sym, c)
      s2 = PAIR(PAIR(i, v), s)
    }
  | fresh (i, c) {
      v = PAIR('var, i)
      u = PAIR('atom, c)
      s2 = PAIR(PAIR(i, u), s)
    }
  | fresh (i, c) {
      v = PAIR('var, i)
      u = PAIR('pair, c)
      s2 = PAIR(PAIR(i, u), s)
    }
  | fresh (i, c) {
      v = PAIR('var, i)
      u = PAIR('sym, c)
      s2 = PAIR(PAIR(i, u), s)
    }
  | fresh (c) {
      u = PAIR('atom, c)
      v = PAIR('atom, c)
      s2 = s
    }
  | fresh (c) {
      u = PAIR('sym, c)
      v = PAIR('sym, c)
      s2 = s
    }
  | fresh (a1, b1, a2, b2, s1) {
      u = PAIR('pair, PAIR(a1, b1))
      v = PAIR('pair, PAIR(a2, b2))
      unify_enc<a1, a2, s> = s1
      unify_enc<b1, b2, s1> = s2
    }
}

;; --- env_find: defs as data — PAIR(name, def) spine; absent
;;     name = stream failure (a refusal) ---
env_find : <name, env> <-> <def> shape self where {
  | fresh (d2, rest) {
      env = PAIR(PAIR(name, d2), rest)
      def = d2
    }
  | fresh (e, rest) {
      env = PAIR(e, rest)
      env_find<name, rest> = def
    }
}

;; --- ren_find / ren_fc: the renaming alist with lazy
;;     find-or-create — rel_eval's ren dict, as data ---
ren_find : <name, ren> <-> <id> shape self where {
  | fresh (id2, rest) {
      ren = PAIR(PAIR(name, id2), rest)
      id = id2
    }
  | fresh (e, rest) {
      ren = PAIR(e, rest)
      ren_find<name, rest> = id
    }
}
ren_fc : <name, ren, n> <-> <o> where {
  | fresh (res) {
      RUN(ren_find<name, ren>, 1) = res
      ren_fc_res<res, name, ren, n> = o
    }
}
ren_fc_res : <res, name, ren, n> <-> <o> where {
  | fresh (id) {
      res = PAIR(id, _)
      o = PAIR(id, PAIR(ren, n))
    }
  | fresh (n2) {
      res = []
      next_id<n> = n2
      o = PAIR(n, PAIR(PAIR(PAIR(name, n), ren), n2))
    }
}

;; --- inst: alpha-rename a clause's 'nvar terms to fresh 'var
;;     ids.  o = PAIR(ren2, PAIR(n2, node2)). ---
inst : <node, ren, n> <-> <o> shape self where {
  | fresh (x, id, r2, n2) {
      node = PAIR('nvar, x)
      ren_fc<x, ren, n> = PAIR(id, PAIR(r2, n2))
      o = PAIR(r2, PAIR(n2, PAIR('var, id)))
    }
  | fresh (c) {
      node = PAIR('atom, c)
      o = PAIR(ren, PAIR(n, node))
    }
  | fresh (c) {
      node = PAIR('sym, c)
      o = PAIR(ren, PAIR(n, node))
    }
  | fresh (a, b, r1, n1, a2, r2, n2, b2) {
      node = PAIR('pair, PAIR(a, b))
      inst<a, ren, n> = PAIR(r1, PAIR(n1, a2))
      inst<b, r1, n1> = PAIR(r2, PAIR(n2, b2))
      o = PAIR(r2, PAIR(n2, PAIR('pair, PAIR(a2, b2))))
    }
  | fresh (a, b, r1, n1, a2, r2, n2, b2) {
      node = PAIR('unify, PAIR(a, b))
      inst<a, ren, n> = PAIR(r1, PAIR(n1, a2))
      inst<b, r1, n1> = PAIR(r2, PAIR(n2, b2))
      o = PAIR(r2, PAIR(n2, PAIR('unify, PAIR(a2, b2))))
    }
  | fresh (nm, at, ot, r0, n0, nm2, r1, n1, at2, r2, n2, ot2) {
      node = PAIR('call, PAIR(nm, PAIR(at, ot)))
      inst<nm, ren, n> = PAIR(r0, PAIR(n0, nm2))
      inst_list<at, r0, n0> = PAIR(r1, PAIR(n1, at2))
      inst<ot, r1, n1> = PAIR(r2, PAIR(n2, ot2))
      o = PAIR(r2, PAIR(n2, PAIR('call, PAIR(nm2, PAIR(at2, ot2)))))
    }
}
inst_list : <lst, ren, n> <-> <o> shape self where {
  | lst = [] { o = PAIR(ren, PAIR(n, [])) }
  | fresh (h, rest, r1, n1, h2, r2, n2, rest2) {
      lst = PAIR(h, rest)
      inst<h, ren, n> = PAIR(r1, PAIR(n1, h2))
      inst_list<rest, r1, n1> = PAIR(r2, PAIR(n2, rest2))
      o = PAIR(r2, PAIR(n2, PAIR(h2, rest2)))
    }
}

;; --- reify: deep walk — the answer as a term, not a spine ---
reify : <t, s> <-> <r> shape self where {
  | fresh (w) {
      walk<t, s> = w
      reify_w<w, s> = r
    }
}
reify_w : <w, s> <-> <r> shape self where {
  | fresh (a, b, ra, rb) {
      w = PAIR('pair, PAIR(a, b))
      reify<a, s> = ra
      reify<b, s> = rb
      r = PAIR('pair, PAIR(ra, rb))
    }
  | fresh (c) {
      w = PAIR('atom, c)
      r = w
    }
  | fresh (c) {
      w = PAIR('sym, c)
      r = w
    }
  | fresh (i) {
      w = PAIR('var, i)
      r = w
    }
}

;; --- eval: goals are enc terms; o = PAIR(s2, n2) ---
eval : <env, goal, s, n> <-> <o> shape self where {
  | fresh (a, b, s2) {
      goal = PAIR('unify, PAIR(a, b))
      unify_enc<a, b, s> = s2
      o = PAIR(s2, n)
    }
  | fresh (nm, at, ot, x, def) {
      goal = PAIR('call, PAIR(nm, PAIR(at, ot)))
      nm = PAIR('sym, x)
      env_find<x, env> = def
      eval_call<env, def, at, ot, s, n> = o
    }
}
eval_call : <env, def, at, ot, s, n> <-> <o> shape self where {
  | fresh (ins, outP, clauses) {
      def = PAIR('def, PAIR(ins, PAIR(outP, clauses)))
      eval_clauses<env, clauses, ins, outP, at, ot, s, n> = o
    }
}
eval_clauses : <env, clauses, ins, outP, at, ot, s, n> <-> <o>
    shape self where {
  | fresh (cl, rest) {
      clauses = PAIR(cl, rest)
      eval_clause<env, cl, ins, outP, at, ot, s, n> = o
    }
  | fresh (cl, rest) {
      clauses = PAIR(cl, rest)
      eval_clauses<env, rest, ins, outP, at, ot, s, n> = o
    }
}
eval_clause : <env, cl, ins, outP, at, ot, s, n> <-> <o> shape self where {
  | fresh (goals, r1, n1, ins2, r2, n2, outP2,
           r3, n3, goals2, s1, s3) {
      cl = PAIR('clause, goals)
      inst_list<ins, [], n> = PAIR(r1, PAIR(n1, ins2))
      inst<outP, r1, n1> = PAIR(r2, PAIR(n2, outP2))
      inst_list<goals, r2, n2> = PAIR(r3, PAIR(n3, goals2))
      unify_args<ins2, at, s> = s1
      unify_enc<ot, outP2, s1> = s3
      eval_body<env, goals2, s3, n3> = o
    }
}
eval_body : <env, goals, s, n> <-> <o> shape self where {
  | goals = [] { o = PAIR(s, n) }
  | fresh (g, rest, s1, n1) {
      goals = PAIR(g, rest)
      eval<env, g, s, n> = PAIR(s1, n1)
      eval_body<env, rest, s1, n1> = o
    }
}
unify_args : <ins, at, s> <-> <s1> shape self where {
  | ins = [] & at = [] { s1 = s }
  | fresh (p, prest, a, arest, s0) {
      ins = PAIR(p, prest)
      at = PAIR(a, arest)
      unify_enc<p, a, s> = s0
      unify_args<prest, arest, s0> = s1
    }
}
