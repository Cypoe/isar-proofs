;; specialize.plex — Futamura.lean's subst_env as corpus data.
;; subst_env<t, env> = residual: 'nvar names bound in env are
;; replaced by their enc-terms; absent stays OPEN (the dynamic
;; boundary — a residual var, not an error).  Everything else
;; walks structurally: leaf tags are identity, cons-spines recurse
;; both children, tagged nodes ('unify/'call/'clause/'def/...)
;; recurse the payload only.
;;
;; Same enc vocabulary as eval.phi — residuals run through the
;; corpus eval unchanged:
;;   specialize<def, env> = subst_env<def, env>
;; and the Futamura-1 square is checkable:
;;   eval<subst_env<def,env>, dynArgs> = eval<def, allArgs>
;;
;; env: PAIR-spine of PAIR('nameSym, encTerm), newest first
;; (assoc — loose, unique-key by construction).
;; uses: std/lists_member_assoc

;; --- leaf-tag probe: 'nvar/'atom/'sym/'var/'pair close the leaf
;;     cases; any other sym head is a node tag whose payload
;;     recurses (clause below guards on absence) ---
tag_known : <s> <-> <hit> where {
  | s = 'nvar { hit = 'yes }
  | s = 'atom { hit = 'yes }
  | s = 'sym  { hit = 'yes }
  | s = 'var  { hit = 'yes }
  | s = 'pair { hit = 'yes }
}

;; --- pair-head probe: the generic clause must exclude pair-car
;;     terms — those are cons-spines handled by the clause above;
;;     without it a pair-headed t unifies s with the pair itself
;;     and yields a second, unsubstituted residual ---
is_pair : <x> <-> <hit> where {
  | fresh (a, b) { x = [a|b]  hit = 'yes }
}

;; --- the 'nvar case resolves through assoc; res casing is data ---
subst_nv : <res, t> <-> <r> where {
  | fresh (v) { res = [v|_]  r = v }
  | res = [] { r = t }      ;; absent env binding: stays open
}

subst_env : <t, env> <-> <r> shape self where {
  | fresh (x, res) {
      t = 'nvar(x)
      RUN(assoc<x, env>, 1) = res
      subst_nv<res, t> = r
    }
  | fresh (c) { t = 'atom(c)  r = t }
  | fresh (c) { t = 'sym(c)   r = t }
  | fresh (c) { t = 'var(c)   r = t }
  | fresh (c, rc) {
      t = 'pair(c)
      subst_env<c, env> = rc
      r = 'pair(rc)
    }
  | t = [] { r = [] }
  | fresh (h, rest, rh, rr) {
      ;; cons-spine (elem is itself a PAIR): lists, arg lists,
      ;; clause lists, the payload of 'pair — recurse both
      t = [[_|_]|rest]
      t = [h|rest]
      subst_env<h, env> = rh
      subst_env<rest, env> = rr
      r = [rh|rr]
    }
  | fresh (s, c, res, pres, rc) {
      ;; any other sym-tagged node: goals ('unify,'call),
      ;; 'clause, 'def, 'spec — head is a non-pair, non-leaf sym,
      ;; payload recurses
      t = [s|c]
      RUN(tag_known<s>, 1) = res
      res = []
      RUN(is_pair<s>, 1) = pres
      pres = []
      subst_env<c, env> = rc
      r = [s|rc]
    }
}

;; --- the Futamura-1 map: residual def = subst_env over the def ---
specialize : <def, env> <-> <resid> where {
  subst_env<def, env> = resid
}
